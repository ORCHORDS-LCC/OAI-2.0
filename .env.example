# OAI-2.0 environment placeholders.
#
# This file is committed as a reference. Do NOT commit a populated
# .env file. .env is in .gitignore.
#
# Replace placeholders with real values only on a developer's local
# machine or in a private deployment. Public mirrors of this repo
# MUST NOT contain real credentials, account IDs, or private
# endpoints.

# Hugging Face Hub token — needed for gated or private models.
# Leave blank for public model downloads.
HF_TOKEN=

# Cloudflare account ID and API token (when the Cloudflare knowledge
# backend is wired). Public commits must NEVER include real values.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Cloudflare D1 / R2 / Workers AI bindings (placeholders).
CLOUDFLARE_D1_DATABASE_ID=
CLOUDFLARE_R2_BUCKET=
CLOUDFLARE_AI_GATEWAY_ID=

# OAI-2.0 local telemetry — when set, the runtime writes JSONL
# evidence records under $OAI2_TELEMETRY_DIR.
OAI2_TELEMETRY_DIR=

# Default model artifact used by scripts/bench.py and the inference
# runtime. Override locally to test a different artifact.
OAI2_DEFAULT_MODEL=mlx-community/Qwen2.5-Coder-0.5B-Instruct-4bit

# Max tokens for the bench probe.
OAI2_BENCH_MAX_TOKENS=64

# --- ORCHORDS public inference gateway (api.orchords.com) ---
#
# OAI2_GATEWAY_API_KEY is the bearer token used by
# oai2.runtime.GatewayRuntime to authenticate against the public ORCHORDS
# inference gateway. When this variable is set, scripts/verify.py runs the
# `gateway-reach` sub-check against the configured base URL; when unset, the
# runtime falls back to the deterministic PlaceholderRuntime.
#
# Public mirrors of this repo MUST NOT contain a real token. Keep
# the populated value in a gitignored `.env` only.
#
# Defaults (used when OAI2_GATEWAY_BASE_URL / OAI2_GATEWAY_MODEL are empty):
#   OAI2_GATEWAY_BASE_URL -> https://api.orchords.com
#   OAI2_GATEWAY_MODEL    -> oai-2.0
#   OAI2_GATEWAY_TIMEOUT_SECONDS -> 60
#
# `oai-2.0` is the only model id the OAI-2.0 client treats as a
# valid cloud target (see `KNOWN_CLOUD_MODELS` in
# `oai2/runtime/gateway_models.py`). Earlier ids (`oai-1.0`,
# `oai-1.2`, `orchordsai-gpt`, `orchordsai-m3`) are deliberately
# filtered out at the client — Refs #237.
OAI2_GATEWAY_API_KEY=
OAI2_GATEWAY_BASE_URL=
OAI2_GATEWAY_MODEL=
OAI2_GATEWAY_TIMEOUT_SECONDS=
